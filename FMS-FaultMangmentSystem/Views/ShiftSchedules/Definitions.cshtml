@model IncidentManagementSystem.ViewModels.ShiftDefinitionCreateViewModel
@{ ViewData["Title"] = "تعريف فترات النوبة"; }
<div class="page-heading"><div><span class="welcome-kicker">إعدادات الجدولة</span><h1>تعريف فترات النوبة</h1><p>أدخل الأوقات حسب احتياج التشغيل. الفترة الممتدة لليوم التالي يجب تحديدها كفترة ليلية.</p></div><a asp-action="Index" class="btn btn-light">العودة للجدول</a></div>
@if (TempData["SuccessMessage"] is string success) { <partial name="_Alert" model="success" view-data="@(new ViewDataDictionary(ViewData) { ["Style"] = "success" })" /> }
@if (TempData["ErrorMessage"] is string error) { <partial name="_Alert" model="error" view-data="@(new ViewDataDictionary(ViewData) { ["Style"] = "danger" })" /> }
<div class="form-panel definition-create-panel"><form asp-action="CreateDefinition" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><h2 class="fs-5 mb-3">إضافة فترة جديدة</h2><div class="assignment-fields"><div><label asp-for="Name" class="form-label">اسم الفترة</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div><label asp-for="StartTime" class="form-label">وقت البداية</label><input asp-for="StartTime" type="time" class="form-control" /><span asp-validation-for="StartTime" class="text-danger"></span></div><div><label asp-for="EndTime" class="form-label">وقت النهاية</label><input asp-for="EndTime" type="time" class="form-control" /><span asp-validation-for="EndTime" class="text-danger"></span></div><div class="form-check form-switch align-self-end mb-3"><input asp-for="IsOvernight" class="form-check-input" /><label asp-for="IsOvernight" class="form-check-label">تنتهي في اليوم التالي</label></div></div><button class="btn btn-primary" type="submit">إضافة الفترة</button></form></div>
<section class="definition-list"><h2 class="fs-5">الفترات النشطة</h2>
@if (((IEnumerable<ShiftDefinitionViewModel>)ViewBag.Definitions).Any())
{
    @foreach (var definition in (IEnumerable<ShiftDefinitionViewModel>)ViewBag.Definitions)
    {
        <form asp-action="UpdateDefinition" method="post" class="definition-card"><input type="hidden" name="id" value="@definition.Id" /><div class="definition-fields"><div><label class="form-label" for="name-@definition.Id">الاسم</label><input id="name-@definition.Id" name="Name" value="@definition.Name" class="form-control" maxlength="100" required /></div><div><label class="form-label" for="start-@definition.Id">البداية</label><input id="start-@definition.Id" name="StartTime" type="time" value="@definition.StartTime.ToString("HH:mm")" class="form-control" required /></div><div><label class="form-label" for="end-@definition.Id">النهاية</label><input id="end-@definition.Id" name="EndTime" type="time" value="@definition.EndTime.ToString("HH:mm")" class="form-control" required /></div><div class="form-check form-switch align-self-end mb-3"><input id="overnight-@definition.Id" name="IsOvernight" type="checkbox" value="true" class="form-check-input" checked="@definition.IsOvernight" /><input name="IsOvernight" type="hidden" value="false" /><label for="overnight-@definition.Id" class="form-check-label">اليوم التالي</label></div><div class="form-check form-switch align-self-end mb-3"><input id="active-@definition.Id" name="IsActive" type="checkbox" value="true" class="form-check-input" checked="@definition.IsActive" /><input name="IsActive" type="hidden" value="false" /><label for="active-@definition.Id" class="form-check-label">نشط</label></div><button type="submit" class="btn btn-outline-primary">حفظ</button></div></form>
    }
}
else { <partial name="_EmptyState" view-data="@(new ViewDataDictionary(ViewData) { ["Title"] = "لا توجد فترات معرفة", ["Message"] = "أضف فترة نوبة لبدء إنشاء الجدول." })" /> }
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
