@model IncidentManagementSystem.ViewModels.UserCreateViewModel
@using IncidentManagementSystem.Authorization
@{ ViewData["Title"] = "إضافة مستخدم"; }
<div class="page-heading"><div><span class="welcome-kicker">إدارة الوصول</span><h1>إضافة مستخدم</h1><p>أنشئ حساباً جديداً وحدد القسم والدور المصرح به.</p></div><a asp-action="Index" class="btn btn-light">العودة للقائمة</a></div>
<div class="form-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="FullName" class="form-label">الاسم الكامل</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Rank" class="form-label">الرتبة</label>
            <select asp-for="Rank" class="form-select" id="Rank">
                <option value="">اختر الرتبة</option>
                @foreach (var rank in (IEnumerable<string>)ViewBag.Ranks)
                {
                    <option value="@rank">@rank</option>
                }
            </select>
            <span asp-validation-for="Rank" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
            <input asp-for="Email" class="form-control" autocomplete="email" dir="ltr" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">كلمة المرور الأولية</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
            <div class="form-text">يجب أن تتوافق كلمة المرور مع سياسة الأمان المعتمدة.</div>
        </div>
        <div class="mb-3">
            <label asp-for="DepartmentId" class="form-label">القسم</label>
            <select asp-for="DepartmentId" class="form-select">
                <option value="">اختر القسم</option>
                @foreach (var department in (IEnumerable<DepartmentViewModel>)ViewBag.Departments)
                {
                    <option value="@department.Id">@department.Name</option>
                }
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="RoleName" class="form-label">الدور</label>
            <input type="hidden" id="RoleNameHidden" name="RoleName" value="@Model.RoleName" />
            <select asp-for="RoleName" class="form-select" id="RoleName">
                <option value="">اختر الدور</option>
                @foreach (var role in (IEnumerable<KeyValuePair<string, string>>)ViewBag.RoleOptions)
                {
                    <option value="@role.Key">@role.Value</option>
                }
            </select>
            <div id="autoRoleHint" class="form-text text-primary" style="display:none;">تم تعيين الدور تلقائيًا: موظف مدني</div>
            <span asp-validation-for="RoleName" class="text-danger"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">إنشاء المستخدم</button>
            <a asp-action="Index" class="btn btn-light">إلغاء</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const rankSelect = document.getElementById('Rank');
            const roleSelect = document.getElementById('RoleName');
            const roleHidden = document.getElementById('RoleNameHidden');
            const autoRoleHint = document.getElementById('autoRoleHint');
            const civilianRole = '@IncidentManagementSystem.Authorization.RolePermissions.CivilianEmployee';

            function syncRole() {
                if (!rankSelect || !roleSelect || !roleHidden) return;

                const isCivilian = rankSelect.value === 'موظف';
                roleSelect.disabled = isCivilian;
                if (isCivilian) {
                    roleSelect.value = civilianRole;
                    roleHidden.value = civilianRole;
                    autoRoleHint.style.display = 'block';
                }
                else {
                    if (!roleSelect.value || roleSelect.value === civilianRole) {
                        roleSelect.value = roleSelect.options.length > 1 ? roleSelect.options[1].value : '';
                    }
                    roleHidden.value = roleSelect.value;
                    autoRoleHint.style.display = 'none';
                }
            }

            rankSelect.addEventListener('change', syncRole);
            roleSelect.addEventListener('change', function () {
                roleHidden.value = roleSelect.value;
            });
            syncRole();
        })();
    </script>
}
