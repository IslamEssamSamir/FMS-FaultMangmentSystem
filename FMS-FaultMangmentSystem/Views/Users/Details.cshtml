@model IncidentManagementSystem.ViewModels.UserViewModel
@using IncidentManagementSystem.Authorization
@{ ViewData["Title"] = "تفاصيل المستخدم"; }
<div class="page-heading"><div><span class="welcome-kicker">إدارة الوصول</span><h1>تفاصيل المستخدم</h1><p>البيانات الأساسية وحالة الحساب والصلاحيات المرتبطة به.</p></div><div class="heading-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a><a asp-action="Index" class="btn btn-light">العودة للقائمة</a></div></div>
<div class="detail-panel"><dl class="detail-grid"><div><dt>الاسم الكامل</dt><dd>@Model.FullName</dd></div><div><dt>الرتبة</dt><dd>@(Model.Rank ?? "—")</dd></div><div><dt>البريد الإلكتروني</dt><dd dir="ltr">@Model.Email</dd></div><div><dt>القسم</dt><dd>@(Model.DepartmentName ?? "—")</dd></div><div><dt>الدور</dt><dd>@(Model.RoleName ?? "—")</dd></div><div><dt>الحالة</dt><dd><span class="status-badge @(Model.IsActive ? "status-resolved" : "status-closed")">@(Model.IsActive ? "نشط" : "غير نشط")</span></dd></div><div><dt>تاريخ الإنشاء</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</dd></div></dl>
<div class="form-actions"><a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-outline-secondary">إعادة تعيين كلمة المرور</a>
<form asp-action="SetActive" method="post" data-confirm-target="#accountStatusConfirm"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="isActive" value="@(!Model.IsActive)" /><button type="submit" class="btn @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(Model.IsActive ? "إيقاف الحساب" : "تفعيل الحساب")</button></form>
@if (User.HasClaim(Permissions.ClaimType, Permissions.ManageRoles)) { <form asp-action="ChangeRole" method="post" class="inline-role-form" data-confirm-target="#roleConfirm"><input type="hidden" name="id" value="@Model.Id" /><label for="roleName" class="visually-hidden">الدور الجديد</label><select id="roleName" name="roleName" class="form-select">@foreach (var role in RolePermissions.All.Keys.OrderBy(item => item)) { <option value="@role" selected="@(role == Model.RoleName)">@role</option> }</select><button type="submit" class="btn btn-outline-primary">تغيير الدور</button></form> }
</div></div>
@{ ViewData["ModalId"] = "roleConfirm"; ViewData["Title"] = "تأكيد تغيير الدور"; ViewData["Message"] = "سيتم تحديث دور المستخدم وصلاحياته المرتبطة. هل تريد المتابعة؟"; ViewData["ConfirmText"] = "تغيير الدور"; ViewData["ConfirmClass"] = "btn-primary"; }
<partial name="_ConfirmationModal" />
@{ ViewData["ModalId"] = "accountStatusConfirm"; ViewData["Title"] = "تأكيد تغيير حالة الحساب"; ViewData["Message"] = "هل تريد تغيير حالة الحساب؟"; ViewData["ConfirmText"] = "تأكيد"; ViewData["ConfirmClass"] = "btn-danger"; }
<partial name="_ConfirmationModal" />
