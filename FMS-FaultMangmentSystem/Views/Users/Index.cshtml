@model IncidentManagementSystem.ViewModels.UserListViewModel
@{ ViewData["Title"] = "المستخدمون"; }
<div class="page-heading"><div><span class="welcome-kicker">إدارة الوصول</span><h1>إدارة المستخدمين</h1><p>إدارة حسابات المستخدمين والأقسام والأدوار.</p></div><a asp-action="Create" class="btn btn-primary">إضافة مستخدم</a></div>
@if (TempData["SuccessMessage"] is string success) { <partial name="_Alert" model="success" view-data="@(new ViewDataDictionary(ViewData) { ["Style"] = "success" })" /> }
@if (TempData["ErrorMessage"] is string error) { <partial name="_Alert" model="error" view-data="@(new ViewDataDictionary(ViewData) { ["Style"] = "danger" })" /> }
<form method="get" class="search-toolbar"><label class="visually-hidden" for="search">البحث عن مستخدم</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="ابحث بالاسم أو البريد أو القسم" /><button class="btn btn-primary" type="submit">بحث</button>@if (!string.IsNullOrWhiteSpace(Model.Search)) { <a asp-action="Index" class="btn btn-light">مسح</a> }</form>
<div class="table-responsive data-table-wrap"><table class="table data-table"><caption class="visually-hidden">قائمة المستخدمين</caption><thead><tr><th>الاسم</th><th>البريد الإلكتروني</th><th>القسم</th><th>الدور</th><th>الحالة</th><th>إجراءات</th></tr></thead><tbody>
@if (Model.Users.Count == 0) { <tr><td class="table-empty" colspan="6">لا يوجد مستخدمون مطابقون.</td></tr> }
@foreach (var user in Model.Users) { <tr><td class="fw-semibold">@user.FullName</td><td dir="ltr" class="text-end">@user.Email</td><td>@(user.DepartmentName ?? "—")</td><td>@(IncidentManagementSystem.Models.Enums.UserRoleSelection.GetDisplayName(user.RoleName) ?? "—")</td><td><span class="status-badge @(user.IsActive ? "status-resolved" : "status-closed")">@(user.IsActive ? "نشط" : "غير نشط")</span></td><td class="table-actions"><a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-light">التفاصيل</a><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">تعديل</a></td></tr> }
</tbody></table></div>
<partial name="_Pagination" model="@(new IncidentManagementSystem.ViewModels.PaginationViewModel { CurrentPage = Model.Page, TotalPages = Model.TotalPages, ActionUrl = Url.Action("Index") ?? "", PageParameter = "page", Search = Model.Search })" />
