@model IncidentManagementSystem.ViewModels.UserPasswordResetViewModel
@{ ViewData["Title"] = "إعادة تعيين كلمة المرور"; }
<div class="page-heading"><div><span class="welcome-kicker">إدارة الوصول</span><h1>إعادة تعيين كلمة المرور</h1><p>تعيين كلمة مرور جديدة للحساب: <strong>@ViewBag.UserName</strong></p></div><a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-light">العودة للتفاصيل</a></div>
<div class="form-panel"><form method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><div class="mb-3"><label asp-for="NewPassword" class="form-label">كلمة المرور الجديدة</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div><div class="mb-4"><label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><div class="form-actions"><button type="submit" class="btn btn-primary">حفظ كلمة المرور</button><a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-light">إلغاء</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
