@model IncidentManagementSystem.ViewModels.DepartmentUpdateViewModel
@{ ViewData["Title"] = "تعديل قسم"; }
<div class="page-heading"><div><span class="welcome-kicker">الإدارة التنظيمية</span><h1>تعديل بيانات القسم</h1><p>حدّث بيانات القسم. تغيير حالة التفعيل متاح من صفحة التفاصيل.</p></div><a asp-action="Index" class="btn btn-light">العودة للقائمة</a></div>
<div class="form-panel"><form asp-action="Edit" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><div class="mb-3"><label asp-for="Name" class="form-label">اسم القسم</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label">الوصف</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div class="form-check form-switch mb-4"><input asp-for="IsIncidentReceivingDepartment" class="form-check-input" /><label asp-for="IsIncidentReceivingDepartment" class="form-check-label">يستقبل بلاغات الأعطال</label></div><div class="form-actions"><button type="submit" class="btn btn-primary">حفظ التعديلات</button><a asp-action="Index" class="btn btn-light">إلغاء</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
