@model IncidentManagementSystem.ViewModels.DepartmentViewModel
@{ ViewData["Title"] = "تفاصيل القسم"; }
<div class="page-heading"><div><span class="welcome-kicker">الإدارة التنظيمية</span><h1>تفاصيل القسم</h1><p>معلومات القسم وحالة استخدامه.</p></div><div class="heading-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a><a asp-action="Index" class="btn btn-light">العودة للقائمة</a></div></div>
<div class="detail-panel"><dl class="detail-grid"><div><dt>اسم القسم</dt><dd>@Model.Name</dd></div><div><dt>الحالة</dt><dd><span class="status-badge @(Model.IsActive ? "status-resolved" : "status-closed")">@(Model.IsActive ? "نشط" : "غير نشط")</span></dd></div><div><dt>استقبال الأعطال</dt><dd>@(Model.IsIncidentReceivingDepartment ? "نعم" : "لا")</dd></div><div><dt>طلب تحويل الأعطال</dt><dd>@(Model.CanSubmitTransferRequests ? "نعم" : "لا")</dd></div><div><dt>تاريخ الإنشاء</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</dd></div><div class="detail-wide"><dt>الوصف</dt><dd>@(Model.Description ?? "لا يوجد وصف")</dd></div></dl><div class="form-actions">
@if (Model.IsActive) { <form asp-action="SetActive" method="post" data-confirm-target="#departmentStatusConfirm"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="isActive" value="false" /><button type="submit" class="btn btn-outline-danger">إيقاف القسم</button></form> } else { <form asp-action="SetActive" method="post" data-confirm-target="#departmentStatusConfirm"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="isActive" value="true" /><button type="submit" class="btn btn-outline-success">تفعيل القسم</button></form> }
</div></div>
@{ ViewData["ModalId"] = "departmentStatusConfirm"; ViewData["Title"] = "تأكيد تغيير الحالة"; ViewData["Message"] = "سيتم تحديث حالة القسم دون حذف سجلاته التاريخية. هل تريد المتابعة؟"; ViewData["ConfirmText"] = "تأكيد"; }
<partial name="_ConfirmationModal" />















































































































