@model IncidentManagementSystem.ViewModels.DepartmentCreateViewModel
@{ ViewData["Title"] = "إضافة قسم"; }
<div class="page-heading"><div><span class="welcome-kicker">الإدارة التنظيمية</span><h1>إضافة قسم</h1><p>أدخل معلومات القسم الأساسية.</p></div><a asp-action="Index" class="btn btn-light">العودة للقائمة</a></div>
<div class="form-panel"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><div class="mb-3"><label asp-for="Name" class="form-label">اسم القسم</label><input asp-for="Name" class="form-control" autocomplete="organization" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label">الوصف</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div class="form-check form-switch mb-4"><input asp-for="IsIncidentReceivingDepartment" class="form-check-input" /><label asp-for="IsIncidentReceivingDepartment" class="form-check-label">يستقبل بلاغات الأعطال</label></div><div class="form-check form-switch mb-4"><input asp-for="CanSubmitTransferRequests" class="form-check-input" /><label asp-for="CanSubmitTransferRequests" class="form-check-label">السماح لضباط القسم بطلب تحويل الأعطال إلى المشرف</label><div class="form-text">عند التفعيل، يستطيع ضباط القسم تقديم طلب تحويل العطل إلى المشرف للنظر فيه. عند التعطيل، لا يُسمح لهم بتقديم طلبات التحويل.</div></div><div class="form-actions"><button type="submit" class="btn btn-primary">حفظ القسم</button><a asp-action="Index" class="btn btn-light">إلغاء</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }









































































































































































































































