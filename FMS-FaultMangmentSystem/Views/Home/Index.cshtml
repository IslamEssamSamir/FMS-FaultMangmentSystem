@model IncidentManagementSystem.ViewModels.DashboardSummaryViewModel?
@using IncidentManagementSystem.Models.Enums
@{
    ViewData["Title"] = "الرئيسية";
}

@if (Model is null)
{
    <section class="welcome-panel">
        <div class="welcome-copy">
            <span class="welcome-kicker">بوابة الخدمات الداخلية</span>
            <h1>مرحباً بك في نظام إدارة الأعطال</h1>
            <p>منصة موحدة لمتابعة البلاغات والتنسيق بين الأقسام والإشراف على خدمات التشغيل المؤسسية.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">تسجيل الدخول إلى النظام</a>
        </div>
        <div class="welcome-emblem" aria-hidden="true"><span>م</span></div>
    </section>

    <section class="feature-grid" aria-label="معلومات النظام">
        <div class="info-card"><span class="info-mark">١</span><h2>تسجيل ومتابعة</h2><p>توثيق البلاغات ومتابعة حالتها عبر مراحل العمل والتاريخ المؤسسي.</p></div>
        <div class="info-card"><span class="info-mark">٢</span><h2>تنسيق مؤسسي</h2><p>دعم التنسيق بين الأقسام وتوزيع العمل وفق الأدوار والسلطات المعتمدة.</p></div>
        <div class="info-card"><span class="info-mark">٣</span><h2>إجراءات واضحة</h2><p>واجهة منظمة لتتبع الحالة، مراجعة الحلول، وتحويل البلاغات عند الحاجة.</p></div>
    </section>
}
else if (Model.Kind == IncidentManagementSystem.ViewModels.DashboardKind.SystemAdministration && Model.Administration is not null)
{
    <div class="page-heading">
        <div>
            <span class="welcome-kicker">لوحة الإدارة</span>
            <h1>ملخص النظام</h1>
            <p>مؤشرات المستخدمين والأقسام والجداول الأسبوعية.</p>
        </div>
    </div>

    <div class="kpi-grid">
        <section class="metric-card"><div class="metric-header"><span class="metric-label">إجمالي المستخدمين</span><span class="metric-icon">👥</span></div><p class="metric-value">@Model.Administration.TotalUsers</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">المستخدمون النشطون</span><span class="metric-icon">✓</span></div><p class="metric-value">@Model.Administration.ActiveUsers</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">إجمالي الأقسام</span><span class="metric-icon">▦</span></div><p class="metric-value">@Model.Administration.TotalDepartments</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">الجداول الأسبوعية</span><span class="metric-icon">◫</span></div><p class="metric-value">@Model.Administration.WeeklySchedules</p></section>
    </div>
}
else if (Model.Kind == IncidentManagementSystem.ViewModels.DashboardKind.Supervisor && Model.Supervisor is not null)
{
    <div class="page-heading">
        <div>
            <span class="welcome-kicker">لوحة المشرف</span>
            <h1>مؤشرات البلاغات</h1>
            <p>ملخص البلاغات وطلبات التحويل والمراجعات على مستوى النظام.</p>
        </div>
    </div>

    <form method="get" asp-action="Index" class="dashboard-date-filter mb-3">
        <label for="dashboardDateFilter" class="form-label">فترة البلاغات</label>
        <select id="dashboardDateFilter" name="filter" class="form-select" onchange="this.form.submit()">
            <option value="Today" selected="@(Model.DateFilter == DashboardDateFilter.Today)">اليوم</option>
            <option value="Week" selected="@(Model.DateFilter == DashboardDateFilter.Week)">الأسبوع</option>
            <option value="Month" selected="@(Model.DateFilter == DashboardDateFilter.Month)">الشهر</option>
            <option value="Year" selected="@(Model.DateFilter == DashboardDateFilter.Year)">السنة</option>
            <option value="All" selected="@(Model.DateFilter == DashboardDateFilter.All)">الكل</option>
        </select>
    </form>

    <div class="kpi-grid dashboard-stat-grid">
        <section class="metric-card"><div class="metric-header"><span class="metric-label">إجمالي الأعطال</span></div><p class="metric-value">@Model.Supervisor.TotalIncidents</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">الأعطال الواردة</span></div><p class="metric-value">@Model.Supervisor.IncomingIncidents</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">الأعطال المفتوحة</span></div><p class="metric-value">@Model.Supervisor.OpenIncidents</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">الأعطال المسددة</span></div><p class="metric-value">@Model.Supervisor.SettledIncidents</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">الأعطال المغلقة</span></div><p class="metric-value">@Model.Supervisor.ClosedIncidentsCount</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">متبقي ولم يغلق</span></div><p class="metric-value">@Model.Supervisor.RemainingNotClosed</p></section>
    </div>

    <div class="dashboard-alert dashboard-alert--@Model.Supervisor.AlertLevel.ToString().ToLowerInvariant()" role="status" aria-live="polite">
        <span class="dashboard-alert-indicator" aria-hidden="true"></span>
        @if (Model.Supervisor.AlertLevel == DashboardAlertLevel.Critical)
        {
            <span>تحذير: يوجد @Model.Supervisor.UnresolvedCriticalIncidents عطل حرج لم يتم إغلاقه.</span>
        }
        else if (Model.Supervisor.AlertLevel == DashboardAlertLevel.Warning)
        {
            <span>تنبيه: يوجد @Model.Supervisor.RemainingNotClosed عطلًا لم يتم إغلاقه.</span>
        }
        else
        {
            <span>آمن: جميع الأعطال مغلقة.</span>
        }
    </div>

    <div class="metric-grid-2">
        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">البلاغات حسب القسم الحالي</h2></div>
            <div class="table-panel">
                <table>
                    <thead><tr><th>القسم</th><th>عدد البلاغات</th></tr></thead>
                    <tbody>
                        @if (Model.Supervisor.IncidentsByDepartment.Count == 0)
                        {
                            <tr><td colspan="2">لا توجد بيانات متاحة.</td></tr>
                        }

                        else
                        {
                            @foreach (var item in Model.Supervisor.IncidentsByDepartment)
                            {
                                <tr><td>@item.DepartmentName</td><td>@item.IncidentCount</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel">
            <div class="panel-header"><h2 class="panel-title">أحدث التحويلات</h2></div>
            <div class="table-panel">
                <table>
                    <thead><tr><th>رقم البلاغ</th><th>الأولوية</th><th>من</th><th>إلى</th><th>التاريخ</th></tr></thead>
                    <tbody>
                        @if (Model.Supervisor.RecentTransfers.Count == 0)
                        {
                            <tr><td colspan="5">لا توجد تحويلات مسجلة.</td></tr>
                        }
                        else
                        {
                            @foreach (var transfer in Model.Supervisor.RecentTransfers)
                            {
                                <tr><td>@transfer.IncidentNumber</td><td><span class="badge rounded-pill @IncidentPriorityDisplay.GetBadgeClass(transfer.Priority)">@IncidentPriorityDisplay.GetLabel(transfer.Priority)</span></td><td>@transfer.FromDepartmentName</td><td>@transfer.ToDepartmentName</td><td>@transfer.TransferDate.ToLocalTime().ToString("g")</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}
else if (Model.Kind == IncidentManagementSystem.ViewModels.DashboardKind.DepartmentOfficer && Model.DepartmentOfficer is not null)
{
    <div class="page-heading">
        <div>
            <span class="welcome-kicker">لوحة القسم</span>
            <h1>ملخص قسم @Model.DepartmentOfficer.DepartmentName</h1>
            <p>البلاغات الحالية وطلبات التحويل ضمن نطاق قسمك.</p>
        </div>
    </div>

    <div class="kpi-grid">
        <section class="metric-card"><div class="metric-header"><span class="metric-label">بلاغات واردة</span><span class="metric-icon">◔</span></div><p class="metric-value">@Model.DepartmentOfficer.IncomingIncidents</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">بلاغات مفتوحة</span><span class="metric-icon">◌</span></div><p class="metric-value">@Model.DepartmentOfficer.OpenIncidents</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">بلاغات محلولة</span><span class="metric-icon">✓</span></div><p class="metric-value">@Model.DepartmentOfficer.ResolvedIncidents</p></section>
        <section class="metric-card"><div class="metric-header"><span class="metric-label">طلبات تحويل معلقة</span><span class="metric-icon">⇄</span></div><p class="metric-value">@Model.DepartmentOfficer.PendingTransferRequests</p></section>
    </div>

    <section class="panel">
        <div class="panel-header"><h2 class="panel-title">أحدث بلاغات القسم</h2></div>
        <div class="table-panel">
            <table>
                <thead><tr><th>رقم البلاغ</th><th>العنوان</th><th>الأولوية</th><th>الحالة</th><th>تاريخ التسجيل</th><th></th></tr></thead>
                <tbody>
                    @if (Model.DepartmentOfficer.RecentIncidents.Count == 0)
                    {
                        <tr><td colspan="6">لا توجد بلاغات متاحة.</td></tr>
                    }
                    else
                    {
                        @foreach (var incident in Model.DepartmentOfficer.RecentIncidents)
                        {
                            <tr class="@incident.Status.ToRowClass()">
                                <td>@incident.IncidentNumber</td>
                                <td>@incident.Title</td>
                                <td><span class="badge rounded-pill @IncidentPriorityDisplay.GetBadgeClass(incident.Priority)">@IncidentPriorityDisplay.GetLabel(incident.Priority)</span></td>
                                <td><partial name="_StatusBadge" model="incident.Status" /></td>
                                <td>@incident.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td><a asp-controller="Incidents" asp-action="Details" asp-route-id="@incident.Id" class="btn btn-outline-primary btn-sm">التفاصيل</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@if (Model is not null && Model.CurrentDutyOfficers.Count > 0)
{
    <div class="metric-grid-2 dashboard-duty-grid">
        <section class="panel duty-panel">
            <div class="panel-header"><h2 class="panel-title">الضباط النبطشية الحالية</h2></div>
            <div class="duty-officer-list">
                @foreach (var officer in Model.CurrentDutyOfficers)
                {
                    <article class="duty-officer-card">
                        <h3>@officer.DepartmentName</h3>
                        @if (officer.HasAssignment)
                        {
                            <p class="duty-officer-name">@officer.OfficerName</p>
                            <p>@(string.IsNullOrWhiteSpace(officer.OfficerRank) ? "—" : officer.OfficerRank)</p>
                        }
                        else
                        {
                            <p class="duty-officer-empty">لا يوجد ضابط نبطشي محدد.</p>
                        }
                        <p class="duty-period">من @officer.StartAt.ToString("g") إلى @officer.EndAt.ToString("g")</p>
                    </article>
                }
            </div>
        </section>
        <section class="panel duty-panel">
            <div class="panel-header"><h2 class="panel-title">الضباط النبطشية أمس</h2></div>
            <div class="duty-officer-list">
                @foreach (var officer in Model.PreviousDutyOfficers)
                {
                    <article class="duty-officer-card">
                        <h3>@officer.DepartmentName</h3>
                        @if (officer.HasAssignment)
                        {
                            <p class="duty-officer-name">@officer.OfficerName</p>
                            <p>@(string.IsNullOrWhiteSpace(officer.OfficerRank) ? "—" : officer.OfficerRank)</p>
                        }
                        else
                        {
                            <p class="duty-officer-empty">لا يوجد ضابط نبطشي محدد.</p>
                        }
                        <p class="duty-period">من @officer.StartAt.ToString("g") إلى @officer.EndAt.ToString("g")</p>
                    </article>
                }
            </div>
        </section>
    </div>
}

@if (Model is not null && (Model.Kind == IncidentManagementSystem.ViewModels.DashboardKind.Supervisor || Model.Kind == IncidentManagementSystem.ViewModels.DashboardKind.DepartmentOfficer))
{
    <section class="panel dashboard-incidents-panel">
        <div class="panel-header"><h2 class="panel-title">الأعطال</h2></div>
        <div class="table-responsive">
            <table id="dashboardIncidentsTable" class="table align-middle w-100"
                   data-source="@Url.Action("DashboardDataTable", "Home")"
                   data-details="@Url.Action("Details", "Incidents")"
                   data-filter="@Model.DateFilter">
                <thead><tr><th>رقم البلاغ</th><th>تاريخ ووقت البلاغ</th><th>عنوان العطل</th><th>القسم المختص</th><th>الأولوية</th><th>الحالة</th><th>المسؤول عن المعالجة</th><th>آخر إجراء</th></tr></thead>
            </table>
        </div>
    </section>
}

@section Scripts {
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
    <script>
        (() => {
            const element = document.getElementById("dashboardIncidentsTable");
            if (!element) return;
            const esc = DataTable.render.text();
            new DataTable(element, {
                processing: true,
                serverSide: true,
                pageLength: 25,
                order: [[1, "desc"]],
                ajax: {
                    url: element.dataset.source,
                    data: request => { request.filter = element.dataset.filter; }
                },
                createdRow: (row, data) => {
                    if (data.isCriticalUnresolved) row.classList.add("dashboard-critical-row");
                },
                columns: [
                    { data: "incidentNumber", render: (value, type, row) => type === "display" ? '<a href="' + element.dataset.details + '/' + encodeURIComponent(row.id) + '">' + esc.display(value) + '</a>' : value },
                    { data: "createdAt", render: value => esc.display(new Date(value).toLocaleString()) },
                    { data: "title", render: esc },
                    { data: "departmentName", render: esc },
                    { data: "priority", render: value => esc.display(value === 1 ? "حرجة" : value === 2 ? "عاجلة جداً" : "عاجلة") },
                    { data: "status", render: value => esc.display(({ 0: "وارد", 1: "مفتوح", 2: "مسدد", 3: "مغلق" })[value] ?? "غير معروف") },
                    { data: "responsibleOfficerName", render: value => esc.display(value ?? "—") },
                    { data: "lastAction", render: value => esc.display(value ?? "—") }
                ]
            });
        })();
    </script>
}






















































































































































































