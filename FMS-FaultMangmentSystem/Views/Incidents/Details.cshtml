@using IncidentManagementSystem.Authorization
@using IncidentManagementSystem.Models.Enums
@model IncidentManagementSystem.ViewModels.IncidentDetailsPageViewModel
@{
    ViewData["Title"] = "تفاصيل البلاغ";
    var incident = Model.Incident;
}

<div class="page-heading">
    <div><span class="welcome-kicker">@incident.IncidentNumber</span><h1>@incident.Title</h1><p>تفاصيل البلاغ والجهات المسؤولة عنه.</p></div>
    <a asp-action="Index" class="btn btn-light">العودة إلى البلاغات</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

<section class="form-panel mb-4">
    <dl class="row">
        <dt class="col-sm-3">الحالة</dt><dd class="col-sm-9">@incident.Status</dd>
        <dt class="col-sm-3">الأولوية</dt><dd class="col-sm-9"><span class="badge rounded-pill @IncidentPriorityDisplay.GetBadgeClass(incident.Priority)">@IncidentPriorityDisplay.GetLabel(incident.Priority)</span></dd>
        <dt class="col-sm-3">جهة الإخطار</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(incident.ReportingEntity) ? "—" : incident.ReportingEntity)</dd>
        <dt class="col-sm-3">اسم القائم بالإخطار</dt><dd class="col-sm-9">@(string.IsNullOrWhiteSpace(incident.ReporterName) ? "—" : incident.ReporterName)</dd>
        <dt class="col-sm-3">رقم التواصل للقائم بالإخطار</dt><dd class="col-sm-9" dir="ltr">@(string.IsNullOrWhiteSpace(incident.ReporterPhone) ? "—" : incident.ReporterPhone)</dd>
        <dt class="col-sm-3">وسيلة الإخطار</dt><dd class="col-sm-9">@NotificationMethodDisplay.GetLabel(incident.NotificationMethod)</dd>
        @if (incident.NotificationMethod == NotificationMethod.Other && !string.IsNullOrWhiteSpace(incident.OtherNotificationMethodDescription))
        {
            <dt class="col-sm-3">توضيح وسيلة الإخطار</dt><dd class="col-sm-9">@incident.OtherNotificationMethodDescription</dd>
        }
        @if (incident.HasOfficialLetterAttachment)
        {
            <dt class="col-sm-3">مرفق الجواب الرسمي</dt><dd class="col-sm-9"><a asp-action="OfficialLetterAttachment" asp-route-id="@incident.Id" class="btn btn-outline-secondary btn-sm">عرض المرفق</a></dd>
        }
        <dt class="col-sm-3">القسم المُبلّغ</dt><dd class="col-sm-9">@incident.ReportingDepartmentName</dd>
        <dt class="col-sm-3">القسم المستقبِل الأولي</dt><dd class="col-sm-9">@incident.InitialReceivingDepartmentName</dd>
        <dt class="col-sm-3">القسم الحالي</dt><dd class="col-sm-9">@incident.CurrentDepartmentName</dd>
        <dt class="col-sm-3">تاريخ البلاغ</dt><dd class="col-sm-9">@incident.CreatedAt.ToLocalTime().ToString("g")</dd>
        <dt class="col-sm-3">الوصف</dt><dd class="col-sm-9" style="white-space: pre-wrap">@incident.Description</dd>
        @if (incident.Status is IncidentStatus.Resolved or IncidentStatus.Closed)
        {
            <dt class="col-sm-3">الحل النهائي</dt><dd class="col-sm-9" style="white-space: pre-wrap">@incident.FinalSolutionDescription</dd>
            <dt class="col-sm-3">خطوات الحل</dt><dd class="col-sm-9" style="white-space: pre-wrap">@incident.ResolutionSteps</dd>
            <dt class="col-sm-3">تم الحل بواسطة</dt><dd class="col-sm-9">@incident.ResolvedByUserName</dd>
            <dt class="col-sm-3">تاريخ الحل</dt><dd class="col-sm-9">@incident.ResolvedAt?.ToLocalTime().ToString("g")</dd>
        }
        @if (incident.Status == IncidentStatus.Closed)
        {
            <dt class="col-sm-3">تاريخ الإغلاق النهائي</dt><dd class="col-sm-9">@incident.ClosedAt?.ToLocalTime().ToString("g")</dd>
        }
    </dl>

    @if (User.HasClaim(Permissions.ClaimType, Permissions.ViewAllIncidents) || User.HasClaim(Permissions.ClaimType, Permissions.ViewDepartmentIncidents))
    {
        <a asp-action="Edit" asp-route-id="@incident.Id" class="btn btn-outline-primary btn-sm mb-3">تعديل بيانات البلاغ</a>
    }

    @if (incident.Status == IncidentStatus.Incoming && User.HasClaim(Permissions.ClaimType, Permissions.OpenIncidents))
    {
        <form asp-action="Open" asp-route-id="@incident.Id" method="post" class="mb-3">
            <button type="submit" class="btn btn-primary">فتح البلاغ</button>
        </form>
    }

    @if (incident.Status == IncidentStatus.Incoming && User.HasClaim(Permissions.ClaimType, Permissions.SubmitTransferRequests))
    {
        if (Model.CanSubmitTransferRequest && Model.ReceivingDepartments.Count > 0)
        {
            <hr />
            <h2 class="h5">طلب تحويل البلاغ</h2>
            <p>لن يؤدي تقديم الطلب إلى تغيير القسم الحالي أو حالة البلاغ. ينفذ المشرف التحويل بعد الموافقة.</p>
            <form asp-action="RequestTransfer" asp-route-id="@incident.Id" method="post">
                <div class="mb-3">
                    <label asp-for="TransferRequest.TargetDepartmentId" class="form-label">القسم المستقبِل المطلوب</label>
                    <select asp-for="TransferRequest.TargetDepartmentId" class="form-select">
                        <option value="">اختر القسم</option>
                        @foreach (var department in Model.ReceivingDepartments)
                        {
                            <option value="@department.Id">@department.Name</option>
                        }
                    </select>
                    <span asp-validation-for="TransferRequest.TargetDepartmentId" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="TransferRequest.Reason" class="form-label">سبب التحويل</label>
                    <textarea asp-for="TransferRequest.Reason" class="form-control" rows="3" maxlength="2000"></textarea>
                    <span asp-validation-for="TransferRequest.Reason" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-outline-primary">إرسال طلب التحويل</button>
            </form>
        }
        else if (!Model.CanSubmitTransferRequest)
        {
            <hr />
            <div class="alert alert-warning" role="alert">عذراً، لا يسمح القسم الحالي لضباطه بطلب تحويل الأعطال إلى المشرف.</div>
        }
    }

    @if (incident.Status == IncidentStatus.Open && User.HasClaim(Permissions.ClaimType, Permissions.AddIncidentActions))
    {
        <hr />
        <h2 class="h5">إضافة إجراء</h2>
        <form asp-action="AddAction" asp-route-id="@incident.Id" method="post">
            <div class="mb-3">
                <label asp-for="Action.ActionDescription" class="form-label">وصف الإجراء</label>
                <textarea asp-for="Action.ActionDescription" class="form-control" rows="3" maxlength="4000"></textarea>
                <span asp-validation-for="Action.ActionDescription" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-outline-primary">حفظ الإجراء</button>
        </form>
    }

    @if (incident.Status == IncidentStatus.Open && User.HasClaim(Permissions.ClaimType, Permissions.ResolveIncidents))
    {
        <hr />
        <h2 class="h5">إرسال الحل للمراجعة</h2>
        <form asp-action="Resolve" asp-route-id="@incident.Id" method="post">
            <div class="mb-3">
                <label asp-for="Resolution.FinalSolutionDescription" class="form-label">وصف الحل النهائي</label>
                <textarea asp-for="Resolution.FinalSolutionDescription" class="form-control" rows="3" maxlength="4000"></textarea>
                <span asp-validation-for="Resolution.FinalSolutionDescription" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Resolution.ResolutionSteps" class="form-label">خطوات الحل</label>
                <textarea asp-for="Resolution.ResolutionSteps" class="form-control" rows="5" maxlength="8000"></textarea>
                <span asp-validation-for="Resolution.ResolutionSteps" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">إرسال إلى المشرف</button>
        </form>
    }

    @if (incident.Status == IncidentStatus.Resolved && User.HasClaim(Permissions.ClaimType, Permissions.CloseIncidents))
    {
        <hr />
        <form asp-action="Close" asp-route-id="@incident.Id" method="post">
            <p>إغلاق نهائي مباشر متاح للمشرف المخوّل. يمكنك استخدام صفحة مراجعة الحلول لتسجيل قرار اعتماد مفصل.</p>
            <button type="submit" class="btn btn-primary">إغلاق البلاغ نهائياً</button>
        </form>
    }
</section>

<section class="form-panel responsibility-panel mb-4" aria-labelledby="departmentResponsibilityHeading">
    <div class="participant-heading">
        <div>
            <h2 id="departmentResponsibilityHeading" class="h5 mb-1">بيانات المسؤولية عن العطل</h2>
            <p class="text-muted mb-0">بيانات الضابط النبطشي محفوظة وفق وقت بدء مسؤولية كل قسم.</p>
        </div>
    </div>
    @if (incident.DepartmentResponsibilities.Count == 0)
    {
        <div class="empty-state participant-empty">
            <p class="mb-0">لا تتوفر بيانات مسؤولية مسجلة لهذا البلاغ.</p>
        </div>
    }
    else
    {
        <div class="table-responsive responsibility-table-wrap">
            <table class="table align-middle responsibility-table">
                <thead>
                    <tr>
                        <th scope="col">القسم</th>
                        <th scope="col">نوع المشاركة</th>
                        <th scope="col">الضابط النبطشي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var responsibility in incident.DepartmentResponsibilities)
                    {
                        <tr class="@(responsibility.IsPrimary ? "responsibility-primary-row" : null)">
                            <td>
                                <span class="responsibility-department">
                                    <span class="department-color-indicator @responsibility.DepartmentColorClass" aria-hidden="true"></span>
                                    <span>@responsibility.DepartmentName</span>
                                </span>
                            </td>
                            <td>
                                <span class="responsibility-badge @(responsibility.IsPrimary ? "responsibility-badge-primary" : "responsibility-badge-participating")">
                                    @(responsibility.IsPrimary ? "رئيسي" : "مشارك")
                                </span>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(responsibility.DutyOfficerFullName))
                                {
                                    <span class="responsibility-unavailable">غير متوفر تاريخيًا</span>
                                }
                                else
                                {
                                    <span class="responsibility-officer">
                                        @if (!string.IsNullOrWhiteSpace(responsibility.DutyOfficerRank))
                                        {
                                            <span class="responsibility-officer-rank">@responsibility.DutyOfficerRank</span>
                                        }
                                        <span>@responsibility.DutyOfficerFullName</span>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="form-panel participant-departments mb-4" aria-labelledby="participantDepartmentsHeading">
    <div class="participant-heading">
        <div>
            <h2 id="participantDepartmentsHeading" class="h5 mb-1">الأقسام المشاركة في معالجة العطل</h2>
            <p class="text-muted mb-0">تتابع كل جهة مهمتها وإجراءاتها بصورة مستقلة عن القسم المسؤول.</p>
        </div>
        @if (Model.CanAddDepartmentAssignments)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
                إضافة قسم مشارك
            </button>
        }
    </div>

    <article class="department-card @incident.CurrentDepartmentColorClass primary-department-card">
        <div class="department-title-wrap">
            <span class="department-color-indicator" aria-hidden="true"></span>
            <div>
                <h3 class="h6 mb-1">@incident.CurrentDepartmentName</h3>
                <span class="task-status-badge task-status-primary">القسم الأساسي المسؤول</span>
            </div>
        </div>
    </article>

    @if (incident.DepartmentAssignments.Count == 0)
    {
        <div class="empty-state participant-empty">
            <h3 class="h6">لا توجد أقسام مشاركة بعد</h3>
            <p class="mb-0">يظل القسم الحالي هو المسؤول الأساسي عن البلاغ.</p>
        </div>
    }
    else
    {
        <div class="participant-list">
            @foreach (var assignment in incident.DepartmentAssignments)
            {
                var (taskStatusLabel, taskStatusClass) = assignment.Status switch
                {
                    IncidentDepartmentTaskStatus.Pending => ("قيد الانتظار", "task-status-pending"),
                    IncidentDepartmentTaskStatus.InProgress => ("قيد التنفيذ", "task-status-progress"),
                    IncidentDepartmentTaskStatus.Completed => ("مكتملة", "task-status-completed"),
                    _ => ("غير معروفة", "task-status-pending")
                };

                <article class="department-card @assignment.DepartmentColorClass">
                    <header class="department-card-header">
                        <div class="department-title-wrap">
                            <span class="department-color-indicator" aria-hidden="true"></span>
                            <div>
                                <h3 class="h6 mb-1">@assignment.DepartmentName</h3>
                                <span class="task-status-badge @taskStatusClass">@taskStatusLabel</span>
                                @if (assignment.RemovedAt is not null)
                                {
                                    <span class="task-status-badge task-status-removed">تمت الإزالة</span>
                                }
                            </div>
                        </div>
                        <div class="assignment-dates text-muted">
                            <span>أُسندت بواسطة @assignment.AssignedByUserName</span>
                            <time datetime="@assignment.AssignedAt.ToString("O")">@assignment.AssignedAt.ToLocalTime().ToString("g")</time>
                            @if (assignment.CompletedAt is DateTime completedAt)
                            {
                                <span>اكتملت في <time datetime="@completedAt.ToString("O")">@completedAt.ToLocalTime().ToString("g")</time></span>
                            }
                        </div>
                    </header>

                    <div class="department-task">
                        <strong>المهمة المطلوبة</strong>
                        <p class="mb-0" style="white-space: pre-wrap">@assignment.RequiredTask</p>
                    </div>

                    @if (assignment.History.Count > 0)
                    {
                        <details class="department-history">
                            <summary>سجل تغييرات المهمة (@assignment.History.Count)</summary>
                            @foreach (var history in assignment.History)
                            {
                                <div class="department-history-entry">
                                    <strong>@history.EventType — @history.ChangedByUserName</strong>
                                    <time datetime="@history.ChangedAt.ToString("O")">@history.ChangedAt.ToLocalTime().ToString("g")</time>
                                    @if (!string.IsNullOrWhiteSpace(history.Notes))
                                    {
                                        <p class="mb-0">@history.Notes</p>
                                    }
                                </div>
                            }
                        </details>
                    }

                    @if (assignment.CanManageOwnTasks)
                    {
                        <div class="department-officer-actions">
                            <form asp-action="AddDepartmentAction" asp-route-id="@incident.Id" asp-route-assignmentId="@assignment.Id" method="post">
                                <label for="DepartmentAction_@assignment.Id" class="form-label">تسجيل إجراء أو تحديث</label>
                                <textarea id="DepartmentAction_@assignment.Id" name="DepartmentAction.ActionDescription" class="form-control" rows="2" maxlength="4000" required>@Model.DepartmentAction.ActionDescription</textarea>
                                <button type="submit" class="btn btn-outline-primary btn-sm mt-2">حفظ الإجراء</button>
                            </form>
                            <form asp-action="UpdateDepartmentTaskStatus" asp-route-id="@incident.Id" asp-route-assignmentId="@assignment.Id" method="post">
                                <label for="DepartmentTaskStatus_@assignment.Id" class="form-label">تحديث حالة المهمة</label>
                                <select id="DepartmentTaskStatus_@assignment.Id" name="DepartmentTaskStatus.Status" class="form-select">
                                    @if (assignment.Status == IncidentDepartmentTaskStatus.Pending)
                                    {
                                        <option value="InProgress">قيد التنفيذ</option>
                                        <option value="Completed">مكتملة</option>
                                    }
                                    else
                                    {
                                        <option value="Completed">مكتملة</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-success btn-sm mt-2">@(assignment.Status == IncidentDepartmentTaskStatus.Pending ? "تحديث الحالة" : "إكمال المهمة")</button>
                            </form>
                        </div>
                    }

                    @if (Model.CanRemoveDepartmentAssignments && assignment.RemovedAt is null)
                    {
                        <form asp-action="RemoveDepartment" asp-route-id="@incident.Id" asp-route-assignmentId="@assignment.Id" method="post" class="department-remove-form">
                            <label for="DepartmentRemoval_@assignment.Id" class="form-label">سبب إزالة القسم</label>
                            <textarea id="DepartmentRemoval_@assignment.Id" name="DepartmentRemoval.Reason" class="form-control" rows="2" maxlength="2000" required>@Model.DepartmentRemoval.Reason</textarea>
                            <button type="submit" class="btn btn-outline-danger btn-sm mt-2">إزالة القسم المشارك</button>
                        </form>
                    }

                    @if (assignment.RemovedAt is not null && !string.IsNullOrWhiteSpace(assignment.RemovalReason))
                    {
                        <p class="department-removal-note mb-0">سبب الإزالة: @assignment.RemovalReason</p>
                    }
                </article>
            }
        </div>
    }
</section>

@if (Model.CanAddDepartmentAssignments)
{
    <div class="modal fade" id="addDepartmentModal" tabindex="-1" aria-labelledby="addDepartmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="AssignDepartment" asp-route-id="@incident.Id" method="post">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="addDepartmentModalLabel">إضافة قسم مشارك</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        @if (Model.AssignableDepartments.Count == 0)
                        {
                            <div class="alert alert-info mb-0">لا توجد أقسام نشطة متاحة للإسناد.</div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label asp-for="DepartmentAssignment.DepartmentId" class="form-label">القسم المشارك</label>
                                <select asp-for="DepartmentAssignment.DepartmentId" class="form-select">
                                    <option value="">اختر القسم</option>
                                    @foreach (var department in Model.AssignableDepartments)
                                    {
                                        <option value="@department.Id">@department.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="DepartmentAssignment.DepartmentId" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="DepartmentAssignment.RequiredTask" class="form-label">المهمة والتعليمات المطلوبة</label>
                                <textarea asp-for="DepartmentAssignment.RequiredTask" class="form-control" rows="4" maxlength="4000"></textarea>
                                <span asp-validation-for="DepartmentAssignment.RequiredTask" class="text-danger"></span>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">إلغاء</button>
                        @if (Model.AssignableDepartments.Count > 0)
                        {
                            <button type="submit" class="btn btn-primary">إسناد القسم</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<section class="form-panel mb-4">
    <h2 class="h5">سجل التحويلات</h2>
    @if (Model.TransferHistory.Count == 0)
    {
        <p class="mb-0">لا توجد تحويلات سابقة لهذا البلاغ.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>من قسم</th><th>إلى قسم</th><th>المشرف</th><th>التاريخ</th><th>السبب</th></tr></thead>
                <tbody>
                @foreach (var transfer in Model.TransferHistory)
                {
                    <tr>
                        <td>@transfer.FromDepartmentName</td>
                        <td>@transfer.ToDepartmentName</td>
                        <td>@transfer.TransferredBySupervisorName</td>
                        <td>@transfer.TransferDate.ToLocalTime().ToString("g")</td>
                        <td>@transfer.TransferReason</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (incident.ActivityTimeline.Count > 0)
{
    <section class="form-panel incident-action-timeline mb-4" aria-labelledby="incidentActionTimelineHeading">
        <h2 id="incidentActionTimelineHeading" class="h5">سجل إجراءات العطل</h2>
        <div class="timeline-list">
        @foreach (var activity in incident.ActivityTimeline)
        {
            var departmentTypeLabel = activity.DepartmentType == "Primary" ? "القسم الأساسي" : "قسم مشارك";
            <article class="incident-timeline-entry @activity.DepartmentColorClass">
                <div class="timeline-heading">
                    <div class="department-title-wrap">
                        <span class="department-color-indicator" aria-hidden="true"></span>
                        <div>
                            <strong>@activity.DepartmentName</strong>
                            <span class="timeline-department-type">@departmentTypeLabel</span>
                        </div>
                    </div>
                    <time datetime="@activity.ActivityAt.ToString("O")">@activity.ActivityAt.ToLocalTime().ToString("g")</time>
                </div>
                <div class="timeline-author">@activity.ActorName</div>
                <p class="timeline-description" style="white-space: pre-wrap">@activity.Description</p>
                @if (activity.AssignmentId is int assignmentId)
                {
                    var assignmentStatusLabel = activity.AssignmentStatus switch
                    {
                        IncidentDepartmentTaskStatus.Pending => "قيد الانتظار",
                        IncidentDepartmentTaskStatus.InProgress => "قيد التنفيذ",
                        IncidentDepartmentTaskStatus.Completed => "مكتملة",
                        _ => "غير معروفة"
                    };
                    <div class="timeline-assignment-context">
                        <span>مهمة الإسناد #@assignmentId</span>
                        <span>الحالة: @assignmentStatusLabel</span>
                        @if (!string.IsNullOrWhiteSpace(activity.AssignmentRequiredTask))
                        {
                            <span>المهمة: @activity.AssignmentRequiredTask</span>
                        }
                    </div>
                }
            </article>
        }
        </div>
    </section>
}

@if (incident.ReviewHistory.Count > 0)
{
    <section class="form-panel mb-4">
        <h2 class="h5">سجل مراجعات المشرف</h2>
        @foreach (var review in incident.ReviewHistory)
        {
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between"><strong>@review.ReviewDecision — @review.SupervisorName</strong><time>@review.ReviewDate.ToLocalTime().ToString("g")</time></div>
                @if (!string.IsNullOrWhiteSpace(review.ReviewNotes))
                {
                    <p class="mb-0 mt-2" style="white-space: pre-wrap">@review.ReviewNotes</p>
                }
            </article>
        }
    </section>
}

@if (incident.StatusHistory.Count > 0)
{
    <section class="form-panel mb-4">
        <h2 class="h5">سجل تغييرات الحالة</h2>
        @foreach (var change in incident.StatusHistory)
        {
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between">
                    <strong>@(change.PreviousStatus is IncidentStatus previousStatus ? $"{previousStatus} → {change.NewStatus}" : change.NewStatus.ToString())</strong>
                    <time>@change.ChangeDate.ToLocalTime().ToString("g")</time>
                </div>
                <div class="text-muted">@change.ChangedByUserName</div>
                @if (!string.IsNullOrWhiteSpace(change.Notes))
                {
                    <p class="mb-0 mt-2" style="white-space: pre-wrap">@change.Notes</p>
                }
            </article>
        }
    </section>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
