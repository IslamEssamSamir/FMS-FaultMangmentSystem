@using IncidentManagementSystem.Authorization
@using IncidentManagementSystem.Models.Enums
@model IncidentManagementSystem.ViewModels.IncidentDetailsPageViewModel
@{
    ViewData["Title"] = "تفاصيل البلاغ";
    var incident = Model.Incident;
}

<div class="page-heading">
    <div><span class="welcome-kicker">@incident.IncidentNumber</span><h1>@incident.Title</h1><p>تفاصيل البلاغ والجهات المسؤولة عنه.</p></div>
    <a asp-action="Index" class="btn btn-light">العودة إلى البلاغات</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<section class="form-panel mb-4">
    <dl class="row">
        <dt class="col-sm-3">الحالة</dt><dd class="col-sm-9">@incident.Status</dd>
        <dt class="col-sm-3">القسم المُبلّغ</dt><dd class="col-sm-9">@incident.ReportingDepartmentName</dd>
        <dt class="col-sm-3">القسم المستقبِل الأولي</dt><dd class="col-sm-9">@incident.InitialReceivingDepartmentName</dd>
        <dt class="col-sm-3">القسم الحالي</dt><dd class="col-sm-9">@incident.CurrentDepartmentName</dd>
        <dt class="col-sm-3">تاريخ البلاغ</dt><dd class="col-sm-9">@incident.CreatedAt.ToLocalTime().ToString("g")</dd>
        <dt class="col-sm-3">الوصف</dt><dd class="col-sm-9" style="white-space: pre-wrap">@incident.Description</dd>
        @if (incident.Status is IncidentStatus.Resolved or IncidentStatus.Closed)
        {
            <dt class="col-sm-3">الحل النهائي</dt><dd class="col-sm-9" style="white-space: pre-wrap">@incident.FinalSolutionDescription</dd>
            <dt class="col-sm-3">خطوات الحل</dt><dd class="col-sm-9" style="white-space: pre-wrap">@incident.ResolutionSteps</dd>
            <dt class="col-sm-3">تم الحل بواسطة</dt><dd class="col-sm-9">@incident.ResolvedByUserName</dd>
            <dt class="col-sm-3">تاريخ الحل</dt><dd class="col-sm-9">@incident.ResolvedAt?.ToLocalTime().ToString("g")</dd>
        }
        @if (incident.Status == IncidentStatus.Closed)
        {
            <dt class="col-sm-3">تاريخ الإغلاق النهائي</dt><dd class="col-sm-9">@incident.ClosedAt?.ToLocalTime().ToString("g")</dd>
        }
    </dl>

    @if (incident.Status == IncidentStatus.Incoming && User.HasClaim(Permissions.ClaimType, Permissions.OpenIncidents))
    {
        <form asp-action="Open" asp-route-id="@incident.Id" method="post" class="mb-3">
            <button type="submit" class="btn btn-primary">فتح البلاغ</button>
        </form>
    }

    @if (incident.Status == IncidentStatus.Incoming && User.HasClaim(Permissions.ClaimType, Permissions.SubmitTransferRequests) && Model.ReceivingDepartments.Count > 0)
    {
        <hr />
        <h2 class="h5">طلب تحويل البلاغ</h2>
        <p>لن يؤدي تقديم الطلب إلى تغيير القسم الحالي أو حالة البلاغ. ينفذ المشرف التحويل بعد الموافقة.</p>
        <form asp-action="RequestTransfer" asp-route-id="@incident.Id" method="post">
            <div class="mb-3">
                <label asp-for="TransferRequest.TargetDepartmentId" class="form-label">القسم المستقبِل المطلوب</label>
                <select asp-for="TransferRequest.TargetDepartmentId" class="form-select">
                    <option value="">اختر القسم</option>
                    @foreach (var department in Model.ReceivingDepartments)
                    {
                        <option value="@department.Id">@department.Name</option>
                    }
                </select>
                <span asp-validation-for="TransferRequest.TargetDepartmentId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TransferRequest.Reason" class="form-label">سبب التحويل</label>
                <textarea asp-for="TransferRequest.Reason" class="form-control" rows="3" maxlength="2000"></textarea>
                <span asp-validation-for="TransferRequest.Reason" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-outline-primary">إرسال طلب التحويل</button>
        </form>
    }

    @if (incident.Status == IncidentStatus.Open && User.HasClaim(Permissions.ClaimType, Permissions.AddIncidentActions))
    {
        <hr />
        <h2 class="h5">إضافة إجراء</h2>
        <form asp-action="AddAction" asp-route-id="@incident.Id" method="post">
            <div class="mb-3">
                <label asp-for="Action.ActionDescription" class="form-label">وصف الإجراء</label>
                <textarea asp-for="Action.ActionDescription" class="form-control" rows="3" maxlength="4000"></textarea>
                <span asp-validation-for="Action.ActionDescription" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-outline-primary">حفظ الإجراء</button>
        </form>
    }

    @if (incident.Status == IncidentStatus.Open && User.HasClaim(Permissions.ClaimType, Permissions.ResolveIncidents))
    {
        <hr />
        <h2 class="h5">إرسال الحل للمراجعة</h2>
        <form asp-action="Resolve" asp-route-id="@incident.Id" method="post">
            <div class="mb-3">
                <label asp-for="Resolution.FinalSolutionDescription" class="form-label">وصف الحل النهائي</label>
                <textarea asp-for="Resolution.FinalSolutionDescription" class="form-control" rows="3" maxlength="4000"></textarea>
                <span asp-validation-for="Resolution.FinalSolutionDescription" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Resolution.ResolutionSteps" class="form-label">خطوات الحل</label>
                <textarea asp-for="Resolution.ResolutionSteps" class="form-control" rows="5" maxlength="8000"></textarea>
                <span asp-validation-for="Resolution.ResolutionSteps" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">إرسال إلى المشرف</button>
        </form>
    }

    @if (incident.Status == IncidentStatus.Resolved && User.HasClaim(Permissions.ClaimType, Permissions.CloseIncidents))
    {
        <hr />
        <form asp-action="Close" asp-route-id="@incident.Id" method="post">
            <p>إغلاق نهائي مباشر متاح للمشرف المخوّل. يمكنك استخدام صفحة مراجعة الحلول لتسجيل قرار اعتماد مفصل.</p>
            <button type="submit" class="btn btn-primary">إغلاق البلاغ نهائياً</button>
        </form>
    }
</section>

<section class="form-panel mb-4">
    <h2 class="h5">سجل التحويلات</h2>
    @if (Model.TransferHistory.Count == 0)
    {
        <p class="mb-0">لا توجد تحويلات سابقة لهذا البلاغ.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>من قسم</th><th>إلى قسم</th><th>المشرف</th><th>التاريخ</th><th>السبب</th></tr></thead>
                <tbody>
                @foreach (var transfer in Model.TransferHistory)
                {
                    <tr>
                        <td>@transfer.FromDepartmentName</td>
                        <td>@transfer.ToDepartmentName</td>
                        <td>@transfer.TransferredBySupervisorName</td>
                        <td>@transfer.TransferDate.ToLocalTime().ToString("g")</td>
                        <td>@transfer.TransferReason</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (incident.Actions.Count > 0)
{
    <section class="form-panel">
        <h2 class="h5">سجل الإجراءات</h2>
        @foreach (var action in incident.Actions)
        {
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between"><strong>@action.UserFullName</strong><time>@action.ActionDate.ToLocalTime().ToString("g")</time></div>
                <p class="mb-0" style="white-space: pre-wrap">@action.ActionDescription</p>
            </article>
        }
    </section>
}

@if (incident.ReviewHistory.Count > 0)
{
    <section class="form-panel mb-4">
        <h2 class="h5">سجل مراجعات المشرف</h2>
        @foreach (var review in incident.ReviewHistory)
        {
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between"><strong>@review.ReviewDecision — @review.SupervisorName</strong><time>@review.ReviewDate.ToLocalTime().ToString("g")</time></div>
                @if (!string.IsNullOrWhiteSpace(review.ReviewNotes))
                {
                    <p class="mb-0 mt-2" style="white-space: pre-wrap">@review.ReviewNotes</p>
                }
            </article>
        }
    </section>
}

@if (incident.StatusHistory.Count > 0)
{
    <section class="form-panel mb-4">
        <h2 class="h5">سجل تغييرات الحالة</h2>
        @foreach (var change in incident.StatusHistory)
        {
            <article class="border-bottom py-3">
                <div class="d-flex justify-content-between">
                    <strong>@(change.PreviousStatus is IncidentStatus previousStatus ? $"{previousStatus} → {change.NewStatus}" : change.NewStatus.ToString())</strong>
                    <time>@change.ChangeDate.ToLocalTime().ToString("g")</time>
                </div>
                <div class="text-muted">@change.ChangedByUserName</div>
                @if (!string.IsNullOrWhiteSpace(change.Notes))
                {
                    <p class="mb-0 mt-2" style="white-space: pre-wrap">@change.Notes</p>
                }
            </article>
        }
    </section>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
