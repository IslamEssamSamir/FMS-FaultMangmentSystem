@using IncidentManagementSystem.Models.Enums
@model object
@{
    var (label, badgeClass) = Model switch
    {
        IncidentStatus.Incoming => ("وارد", "text-bg-warning"),
        IncidentStatus.Open => ("مفتوح", "text-bg-info"),
        IncidentStatus.Resolved => ("مسدد", "text-bg-primary"),
        IncidentStatus.Closed => ("مغلق", "text-bg-success"),
        TransferRequestStatus.Pending => ("قيد المراجعة", "text-bg-warning"),
        TransferRequestStatus.Approved => ("موافق", "text-bg-success"),
        TransferRequestStatus.Rejected => ("مرفوض", "text-bg-danger"),
        _ => ("غير معروف", "text-bg-secondary")
    };
}
<span class="status-badge badge rounded-pill @badgeClass">@label</span>

















































































































