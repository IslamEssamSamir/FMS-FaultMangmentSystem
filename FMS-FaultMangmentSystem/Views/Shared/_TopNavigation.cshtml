<header class="topbar">
    <div class="topbar-start">
        <button class="icon-button sidebar-toggle" id="sidebarToggle" type="button" aria-label="فتح أو إغلاق القائمة" aria-controls="appSidebar" aria-expanded="false">
            <span aria-hidden="true">☰</span>
        </button>
        <div class="topbar-heading">
            <span class="topbar-eyebrow">بوابة الخدمات الداخلية</span>
            <span class="topbar-title">@ViewData["Title"]</span>
        </div>
    </div>

    <div class="topbar-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            var displayName = User.Identity.Name ?? "المستخدم";
            var profileInitials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(part => part[0]).Take(2)).ToUpperInvariant();

            <div class="profile-menu">
                <div class="profile-avatar" aria-hidden="true">@profileInitials</div>
                <div class="profile-details">
                    <span class="profile-name">@displayName</span>
                    <span class="profile-role">@ViewContext.RouteData.Values["controller"]</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-outline-secondary btn-sm" type="submit">خروج</button>
                </form>
            </div>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">تسجيل الدخول</a>
        }
    </div>
</header>



































































































































































