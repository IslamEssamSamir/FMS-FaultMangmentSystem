@{
    var title = ViewData["Title"]?.ToString() ?? "لا توجد بيانات";
    var message = ViewData["Message"]?.ToString() ?? "لا توجد عناصر لعرضها حالياً.";
    var actionText = ViewData["ActionText"]?.ToString();
    var actionUrl = ViewData["ActionUrl"]?.ToString();
}
<section class="empty-state" role="status">
    <span class="empty-state-icon" aria-hidden="true">⌕</span>
    <h2>@title</h2>
    <p>@message</p>
    @if (!string.IsNullOrWhiteSpace(actionText) && !string.IsNullOrWhiteSpace(actionUrl)) { <a href="@actionUrl" class="btn btn-primary">@actionText</a> }
</section>
